    "preview": "vite preview",
    "dist": "node scripts/assert-production-safe.mjs && node scripts/assert-license-production-config.mjs && npm run build && node scripts/build-installer.mjs",
    "dist:installer": "node scripts/assert-production-safe.mjs && node scripts/assert-license-production-config.mjs && npm run build && node scripts/build-installer.mjs",
    "server:dev": "cd server && npm run start:dev",
    "server:build": "cd server && npm run build",
    "server:start": "cd server && npm run start:prod",
    "server:install": "cd server && npm install",
    "server:prisma:migrate": "cd server && npm run prisma:migrate",
    "server:prisma:generate": "cd server && npm run prisma:generate",
    "server:seed": "cd server && npm run db:seed",
    "import:legacy": "npm run build && electron . --import-legacy=\"C:\\Users\\lenovo\\Downloads\\hotel_metrics_pro (25).sql\"",
    "postinstall": "node scripts/rebuild-native.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "test:rh-paie": "node scripts/test-rh-paie-dz.mjs",
    "verify:phase3": "electron scripts/verify-phase3.mjs",
    "audit:ipc": "node scripts/audit-ipc-security.mjs",
    "validate:packaging": "node scripts/validate-packaging.mjs",
    "validate:certification": "npm test && npm run audit:ipc && npm run validate:packaging && tsc --noEmit",
    "generate:license": "node scripts/generate-license-key.mjs",
    "setup:license-keys": "node scripts/setup-license-signing-keys.mjs",
    "license-manager:install": "cd license-manager && npm install",
    "license-manager:dev": "cd license-manager && npm run dev",
    "license-manager:build": "cd license-manager && npm run build",
    "seed:pms": "electron scripts/seed-pms-demo.mjs",
    "seed:demo": "electron scripts/seed-demo-full.mjs",
    "reset:db": "electron scripts/reset-db-superadmin.mjs",
    "i18n:extract": "node scripts/extract-ui-strings.mjs",
    "i18n:translate": "node scripts/translate-ui-catalog.mjs en ar",
    "i18n:check": "node scripts/check-i18n-catalog.mjs"
  },
